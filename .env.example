# Copy to .env.local for local development.
# Origin of the Orbit backend. The waitlist forms POST to ${VITE_API_URL}/api/v1/waitlist.
# The backend must list this site's origin in WEBSITE_URL so CORS allows the request.
VITE_API_URL=http://localhost:3001

# This site's own public origin (not the backend). Used for canonical / og:url links.
# Optional — defaults to the origin the site is served from.
VITE_WEBSITE_URL=https://xapely-web.onrender.com
